{
  "name": "mymake",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <21"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint . --ignore-pattern next-env.d.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:benchmarks": "tsx scripts/run-reliability-benchmarks.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --incremental false",
    "codex-bridge": "tsx scripts/codex-bridge.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.86.1",
    "@heroicons/react": "^2.1.5",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/webcomponents": "^2.1.5",
    "@privy-io/node": "^0.14.0",
    "@privy-io/react-auth": "^3.21.2",
    "@types/ws": "^8.18.1",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "http-proxy-middleware": "^3.0.7",
    "lucide-react": "^1.8.0",
    "mime-types": "^3.0.2",
    "nanoid": "^5.1.7",
    "next": "15.5.21",
    "openai": "^6.34.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tiktoken": "^1.0.22",
    "tsx": "^4.21.0",
    "unzipper": "^0.12.3",
    "viem": "^2.55.10",
    "ws": "^8.21.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@figma/rest-api-spec": "^0.37.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "eslint": "^8",
    "eslint-config-next": "15.5.9",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "@coinbase/cdp-sdk": {
      "axios": "1.18.1"
    },
    "next": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    },
    "viem": {
      "ws": "$ws"
    }
  }
}
